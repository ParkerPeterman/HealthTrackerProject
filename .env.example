# Copy to .env and adjust. .env is git-ignored.

# --- Database (Postgres runs in Docker, published on localhost only)
POSTGRES_USER=health
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://health:change-me@127.0.0.1:5432/healthtracker
DEMO_DATABASE_URL=postgresql://health:change-me@127.0.0.1:5432/healthtracker_demo
TEST_DATABASE_URL=postgresql://health:change-me@127.0.0.1:5432/healthtracker_test

# --- Local time zone (used for dates; also settable in the app)
TZ=America/Chicago

# --- Garmin Connect. Only the email lives here. Run `healthtracker garmin-login`
#     once; it asks for the password (and MFA code) and stores refresh tokens in
#     GARMIN_TOKENSTORE. The Docker services mount ./secrets/garmin there.
GARMIN_EMAIL=
GARMIN_TOKENSTORE=./secrets/garmin
GARMIN_FETCH_FIT=true

# --- Weather (Open-Meteo, free for non-commercial use, no key). Your home location for
#     outdoor sessions and the planner's forecast. It is rounded to 0.1 degree (about 11 km)
#     before anything is sent; only the rounded point and dates leave the machine.
# HOME_LAT=41.9
# HOME_LON=-87.6
WEATHER_ENABLED=true

# --- LLM. It only phrases decisions; if it is down or its output fails the checks, a
#     fixed template is used. LLM_PROVIDER picks the backend:
#       ollama  Ollama's native API at OLLAMA_URL (default)
#       openai  any OpenAI-compatible server (llama.cpp, vLLM, LM Studio...) at LLM_BASE_URL,
#               which must end in /v1. It must support response_format json_schema.
#     The day's status and actions are sent (never medication data), so point it only at a
#     machine you control.
LLM_ENABLED=true
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
# LLM_BASE_URL=http://192.168.40.21:9292/v1
# LLM_API_KEY=none
LLM_MODEL=qwen3:14b
LLM_TIMEOUT_S=120

# --- Services bind to localhost; use `tailscale serve` for phone access.
BIND_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_PORT=8501
