# Copy to .env and adjust. .env is git-ignored.

# --- Database (Postgres runs in Docker, published on localhost only)
POSTGRES_USER=health
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://health:change-me@127.0.0.1:5432/healthtracker
DEMO_DATABASE_URL=postgresql://health:change-me@127.0.0.1:5432/healthtracker_demo
TEST_DATABASE_URL=postgresql://health:change-me@127.0.0.1:5432/healthtracker_test

# --- Local time zone (used for dates; also settable in the app)
TZ=America/Chicago

# --- Garmin Connect. Only the email lives here. Run `healthtracker garmin-login`
#     once; it asks for the password (and MFA code) and stores refresh tokens in
#     GARMIN_TOKENSTORE. The Docker services mount ./secrets/garmin there.
GARMIN_EMAIL=
GARMIN_TOKENSTORE=./secrets/garmin
GARMIN_FETCH_FIT=true

# --- Local LLM (Ollama on the host). The LLM only phrases decisions.
LLM_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:14b

# --- Services bind to localhost; use `tailscale serve` for phone access.
BIND_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_PORT=8501
